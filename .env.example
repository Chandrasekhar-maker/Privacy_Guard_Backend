# PrivacyGuard Backend Environment Variables
# Copy this to .env for local development
# NEVER commit .env to git!

# ─── Firebase ─────────────────────────────────────────────────────────────────
# Option A: Path to service account key file (local dev)
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json

# Option B: Paste entire JSON content (for Render.com — set in dashboard)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ─── App URLs ─────────────────────────────────────────────────────────────────
APK_DOWNLOAD_URL=https://your-project.web.app/PrivacyGuard.apk
WEB_HOSTING_URL=https://your-project.web.app

# ─── Environment ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
PYTHONUNBUFFERED=1
